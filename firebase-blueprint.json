{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile, credentials, and settings",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Numeric ID" },
        "name": { "type": "string", "description": "User full name" },
        "email": { "type": "string", "description": "User email" },
        "whatsapp": { "type": "string", "description": "WhatsApp or contact identifier" },
        "password_hash": { "type": "string", "description": "Bcrypt password hash" },
        "role": { "type": "string", "description": "User role (admin or user)" },
        "avatar_url": { "type": "string", "description": "Avatar URL" },
        "visits_count": { "type": "number", "description": "Login visit count" },
        "is_banned": { "type": "number", "description": "Banned flag (0 or 1)" },
        "snow_enabled": { "type": "number", "description": "Snow effect preference" },
        "theme": { "type": "string", "description": "Theme preference ('dark' or 'light')" },
        "high_contrast": { "type": "number", "description": "High contrast preference" },
        "onboarding_completed": { "type": "number", "description": "Onboarding completed flag" },
        "onboarding_step": { "type": "number", "description": "Current onboarding step" },
        "location_permission_granted": { "type": "number", "description": "Whether location permission was granted (0 or 1)" },
        "motion_permission_granted": { "type": "number", "description": "Whether motion/orientation permission was granted (0 or 1)" },
        "last_access": { "type": "string", "description": "Timestamp of last access" },
        "created_at": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["email", "password_hash"]
    },
    "Session": {
      "title": "Session",
      "description": "User session token mapping",
      "type": "object",
      "properties": {
        "token": { "type": "string", "description": "Session token" },
        "user_id": { "type": "number", "description": "User ID" },
        "user_email": { "type": "string", "description": "User Email" },
        "created_at": { "type": "string", "description": "Session creation timestamp" }
      },
      "required": ["token", "user_email"]
    },
    "Spot": {
      "title": "Spot",
      "description": "Tourist spot and point of interest on the map",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Spot identifier" },
        "name": { "type": "string", "description": "Spot full title" },
        "short_name": { "type": "string", "description": "Short name for badges" },
        "tag_label": { "type": "string", "description": "Tag label" },
        "category": { "type": "string", "description": "Category slug" },
        "category_label": { "type": "string", "description": "Category friendly title" },
        "lat": { "type": "number", "description": "Latitude coordinate" },
        "lng": { "type": "number", "description": "Longitude coordinate" },
        "image": { "type": "string", "description": "Cover image URL" },
        "gallery": { "type": "string", "description": "JSON string array of gallery URLs" },
        "description": { "type": "string", "description": "Spot description" },
        "tourist_tip": { "type": "string", "description": "Tourist tip text" },
        "rating": { "type": "number", "description": "Rating score (0 to 5)" },
        "review_count": { "type": "number", "description": "Number of reviews" },
        "hours": { "type": "string", "description": "Operating hours" },
        "address": { "type": "string", "description": "Physical address" },
        "price_range": { "type": "string", "description": "Price indicator" },
        "popular_times": { "type": "string", "description": "Popular times string" },
        "visitors_today": { "type": "number", "description": "Today visitor count" },
        "badge": { "type": "string", "description": "Highlight badge label" },
        "highlighted": { "type": "number", "description": "Is highlighted flag" },
        "is_active": { "type": "number", "description": "Is active on map flag" },
        "is_verified": { "type": "number", "description": "Is verified flag" },
        "available_for_itinerary": { "type": "number", "description": "Whether spot can be used in itinerary generator (0 or 1)" },
        "duration_minutes": { "type": "number", "description": "Suggested visit duration in minutes" },
        "tags": { "type": "string", "description": "Comma separated or JSON tags" },
        "price": { "type": "string", "description": "Specific price or pricing note" },
        "website": { "type": "string", "description": "Website URL" },
        "phone": { "type": "string", "description": "Phone number" },
        "maps_url": { "type": "string", "description": "Google Maps external URL" },
        "created_at": { "type": "string", "description": "Creation timestamp" },
        "updated_at": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "name", "category", "lat", "lng", "image"]
    },
    "MapVisualIcon": {
      "title": "MapVisualIcon",
      "description": "Visual non-interactive icon marker firmly anchored to GPS position",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Visual icon ID" },
        "category": { "type": "string", "description": "Icon category identifier" },
        "icon": { "type": "string", "description": "Icon type identifier" },
        "latitude": { "type": "number", "description": "Latitude coordinate" },
        "longitude": { "type": "number", "description": "Longitude coordinate" },
        "is_active": { "type": "number", "description": "Active flag (0 or 1)" },
        "created_at": { "type": "string", "description": "Creation timestamp" },
        "updated_at": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "category", "icon", "latitude", "longitude"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "System-wide persistent configuration (map settings, camera, community links)",
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "Configuration key" },
        "value": { "type": "string", "description": "Configuration value" },
        "updated_at": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["key", "value"]
    },
    "Event": {
      "title": "Event",
      "description": "City event or festival",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Event ID" },
        "name": { "type": "string", "description": "Event name" },
        "description": { "type": "string", "description": "Event description" },
        "image": { "type": "string", "description": "Image URL" },
        "category": { "type": "string", "description": "Event category" },
        "date": { "type": "string", "description": "Date label" },
        "time": { "type": "string", "description": "Time label" },
        "address": { "type": "string", "description": "Address" },
        "lat": { "type": "number", "description": "Latitude coordinate" },
        "lng": { "type": "number", "description": "Longitude coordinate" },
        "status": { "type": "string", "description": "Event status" },
        "highlighted": { "type": "number", "description": "Highlighted flag" },
        "created_at": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "name", "lat", "lng"]
    },
    "Review": {
      "title": "Review",
      "description": "Spot review and rating",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Review ID" },
        "spot_id": { "type": "string", "description": "Spot ID" },
        "user_id": { "type": "number", "description": "User ID" },
        "user_name": { "type": "string", "description": "Author name" },
        "user_avatar": { "type": "string", "description": "Author avatar URL" },
        "rating": { "type": "number", "description": "Rating given" },
        "comment": { "type": "string", "description": "Review text" },
        "created_at": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["spot_id", "rating"]
    },
    "ItineraryCategory": {
      "title": "ItineraryCategory",
      "description": "Category for filtering and organizing travel routes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Category slug" },
        "name": { "type": "string", "description": "Category friendly title" },
        "icon": { "type": "string", "description": "Lucide icon identifier" },
        "description": { "type": "string", "description": "Category description" },
        "is_active": { "type": "number", "description": "Active flag (0 or 1)" },
        "sort_order": { "type": "number", "description": "Display sort order" },
        "created_at": { "type": "string", "description": "Creation timestamp" },
        "updated_at": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "name"]
    },
    "Itinerary": {
      "title": "Itinerary",
      "description": "Curated or admin-managed travel route for Campos do Jordão",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Itinerary ID" },
        "title": { "type": "string", "description": "Itinerary name" },
        "description": { "type": "string", "description": "Itinerary summary description" },
        "cover_image": { "type": "string", "description": "Cover photo URL" },
        "days_count": { "type": "number", "description": "Duration in days" },
        "categories": { "type": "string", "description": "JSON array of category slugs" },
        "is_active": { "type": "number", "description": "Active in app flag (0 or 1)" },
        "is_recommended": { "type": "number", "description": "Recommended highlight flag" },
        "usage_count": { "type": "number", "description": "Number of users who created or saved this route" },
        "notes": { "type": "string", "description": "General travel advice or instructions" },
        "created_at": { "type": "string", "description": "Creation timestamp" },
        "updated_at": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "title"]
    },
    "ItineraryDay": {
      "title": "ItineraryDay",
      "description": "A single day segment within an itinerary",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Day record ID" },
        "itinerary_id": { "type": "string", "description": "Parent itinerary ID" },
        "day_number": { "type": "number", "description": "Day index (1, 2, 3...)" },
        "title": { "type": "string", "description": "Day heading title" },
        "summary": { "type": "string", "description": "Day summary note" },
        "created_at": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "itinerary_id", "day_number"]
    },
    "ItineraryStep": {
      "title": "ItineraryStep",
      "description": "A spot stop on a specific day in an itinerary",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Step record ID" },
        "itinerary_id": { "type": "string", "description": "Parent itinerary ID" },
        "day_id": { "type": "string", "description": "Parent day record ID" },
        "spot_id": { "type": "string", "description": "Referenced tourist spot ID" },
        "step_order": { "type": "number", "description": "Sequence order index (1, 2, 3...)" },
        "suggested_time": { "type": "string", "description": "Suggested arrival time (e.g. 09:30)" },
        "duration_minutes": { "type": "number", "description": "Suggested duration at spot" },
        "notes": { "type": "string", "description": "Specific tip for this stop" },
        "created_at": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "itinerary_id", "day_id", "spot_id", "step_order"]
    },
    "UserItinerary": {
      "title": "UserItinerary",
      "description": "User created or customized itinerary",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User itinerary ID" },
        "user_id": { "type": "number", "description": "User ID if authenticated" },
        "session_id": { "type": "string", "description": "Session ID if guest" },
        "title": { "type": "string", "description": "Itinerary title" },
        "description": { "type": "string", "description": "Description" },
        "cover_image": { "type": "string", "description": "Cover image URL" },
        "days_count": { "type": "number", "description": "Days duration" },
        "trip_date": { "type": "string", "description": "Planned trip date" },
        "pace": { "type": "string", "description": "Travel pace (Relaxado, Equilibrado, Intenso)" },
        "has_car": { "type": "number", "description": "Travelling by car flag (0 or 1)" },
        "less_walking": { "type": "number", "description": "Less walking preference" },
        "prioritize_food": { "type": "number", "description": "Prioritize gastronomic stops" },
        "prioritize_attractions": { "type": "number", "description": "Prioritize tourist attractions" },
        "preferences_json": { "type": "string", "description": "JSON object of preferences" },
        "itinerary_data_json": { "type": "string", "description": "Full structured JSON days and steps" },
        "created_at": { "type": "string", "description": "Creation timestamp" },
        "updated_at": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["id", "title", "itinerary_data_json"]
    },
    "PlannerSetting": {
      "title": "PlannerSetting",
      "description": "Configuration settings for route generator and planner",
      "type": "object",
      "properties": {
        "key": { "type": "string", "description": "Setting key" },
        "value": { "type": "string", "description": "Setting value" },
        "updated_at": { "type": "string", "description": "Update timestamp" }
      },
      "required": ["key", "value"]
    },
    "Post": {
      "title": "Post",
      "description": "Social feed publication with photo and engagement counts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Post unique ID" },
        "userId": { "type": "string", "description": "Author user ID" },
        "userName": { "type": "string", "description": "Author display name" },
        "userPhoto": { "type": "string", "description": "Author profile avatar URL" },
        "imageUrl": { "type": "string", "description": "Photo URL" },
        "caption": { "type": "string", "description": "Optional caption or description" },
        "location": { "type": "string", "description": "Location tag" },
        "likesCount": { "type": "number", "description": "Total like count" },
        "commentsCount": { "type": "number", "description": "Total comment count" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "userId", "userName", "imageUrl", "createdAt"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Like record on a publication",
      "type": "object",
      "properties": {
        "postId": { "type": "string", "description": "Referenced post ID" },
        "userId": { "type": "string", "description": "Liking user ID" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["postId", "userId"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment on a publication",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Comment ID" },
        "postId": { "type": "string", "description": "Referenced post ID" },
        "userId": { "type": "string", "description": "Author user ID" },
        "userName": { "type": "string", "description": "Author display name" },
        "userPhoto": { "type": "string", "description": "Author avatar URL" },
        "text": { "type": "string", "description": "Comment text" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "postId", "userId", "text", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "24-hour ephemeral story video or image",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Story unique ID" },
        "userId": { "type": "string", "description": "Author user ID" },
        "userName": { "type": "string", "description": "Author display name" },
        "userPhoto": { "type": "string", "description": "Author avatar URL" },
        "mediaUrl": { "type": "string", "description": "Story media URL" },
        "mediaType": { "type": "string", "description": "image or video" },
        "caption": { "type": "string", "description": "Optional story caption" },
        "location": { "type": "string", "description": "Optional tourist location tag" },
        "viewsCount": { "type": "number", "description": "Count of views" },
        "createdAt": { "type": "string", "description": "ISO timestamp of creation" },
        "expiresAt": { "type": "string", "description": "ISO timestamp of expiration (24h after creation)" },
        "status": { "type": "string", "description": "active or deleted" }
      },
      "required": ["id", "userId", "mediaUrl", "createdAt", "expiresAt"]
    },
    "HostProfile": {
      "title": "HostProfile",
      "description": "Host affiliate onboarding profile and payout setup state tied to authenticated user",
      "type": "object",
      "properties": {
        "user_id": { "type": "number", "description": "Authenticated user ID" },
        "user_email": { "type": "string", "description": "Normalized user email" },
        "status": { "type": "string", "description": "Onboarding status ('incomplete' or 'completed')" },
        "onboarding_completed": { "type": "number", "description": "Completion flag (0 or 1)" },
        "current_step": { "type": "number", "description": "Current onboarding step (1 to 3)" },
        "full_name": { "type": "string", "description": "Host legal full name" },
        "contact_email": { "type": "string", "description": "Host contact email" },
        "cpf_masked": { "type": "string", "description": "Masked CPF for display" },
        "cpf_hash": { "type": "string", "description": "SHA-256 hash of CPF" },
        "birth_date": { "type": "string", "description": "Birth date (DD/MM/YYYY)" },
        "phone": { "type": "string", "description": "Phone number with DDD" },
        "cep": { "type": "string", "description": "Postal code (CEP)" },
        "street": { "type": "string", "description": "Street or avenue" },
        "number": { "type": "string", "description": "Address number" },
        "complement": { "type": "string", "description": "Optional address complement" },
        "neighborhood": { "type": "string", "description": "Neighborhood" },
        "city": { "type": "string", "description": "City" },
        "state": { "type": "string", "description": "State UF code" },
        "referral_code": { "type": "string", "description": "Host referral code" },
        "stripe_onboarding_status": { "type": "string", "description": "Stripe verification state" },
        "completed_at": { "type": "string", "description": "ISO timestamp of completion" },
        "updated_at": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["user_id", "user_email", "status", "onboarding_completed"]
    },
    "UserPermission": {
      "title": "UserPermission",
      "description": "Persistent location and motion sensor permission grant state",
      "type": "object",
      "properties": {
        "location_permission_granted": { "type": "number", "description": "Location permission granted flag (0 or 1)" },
        "motion_permission_granted": { "type": "number", "description": "Motion permission granted flag (0 or 1)" },
        "last_lng": { "type": "number", "description": "Last granted longitude" },
        "last_lat": { "type": "number", "description": "Last granted latitude" },
        "updated_at": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "UserFavorite": {
      "title": "UserFavorite",
      "description": "Per-account saved itineraries, spots, and removed list items",
      "type": "object",
      "properties": {
        "user_id": { "type": "string", "description": "User numeric/string ID" },
        "user_email": { "type": "string", "description": "Normalized user email" },
        "itineraries": { "type": "array", "description": "Saved itinerary IDs" },
        "spots": { "type": "array", "description": "Saved tourist spot IDs" },
        "places": { "type": "array", "description": "Removed list item IDs" },
        "updated_at": { "type": "string", "description": "ISO timestamp of last update" }
      }
    }
  },
  "firestore": {
    "/users/{email}": {
      "schema": "User",
      "description": "Persistent users indexed by clean email"
    },
    "/user_favorites/{email}": {
      "schema": "UserFavorite",
      "description": "Per-account saved favorites and activity indexed by clean email"
    },
    "/user_permissions/{key}": {
      "schema": "UserPermission",
      "description": "Persistent location and motion permissions indexed by user email or global_device"
    },
    "/host_profiles/{email}": {
      "schema": "HostProfile",
      "description": "Persistent host affiliate registration profiles indexed by clean email"
    },
    "/sessions/{token}": {
      "schema": "Session",
      "description": "Persistent active sessions indexed by token"
    },
    "/spots/{id}": {
      "schema": "Spot",
      "description": "Persistent tourist spots on the map"
    },
    "/map_visual_icons/{id}": {
      "schema": "MapVisualIcon",
      "description": "Persistent map visual icons"
    },
    "/system_settings/{key}": {
      "schema": "SystemSetting",
      "description": "Persistent system and map settings"
    },
    "/events/{id}": {
      "schema": "Event",
      "description": "Persistent city events"
    },
    "/reviews/{id}": {
      "schema": "Review",
      "description": "Persistent spot reviews"
    },
    "/itinerary_categories/{id}": {
      "schema": "ItineraryCategory",
      "description": "Persistent route categories"
    },
    "/itineraries/{id}": {
      "schema": "Itinerary",
      "description": "Persistent curated routes"
    },
    "/user_itineraries/{id}": {
      "schema": "UserItinerary",
      "description": "Persistent user custom itineraries"
    },
    "/planner_settings/{key}": {
      "schema": "PlannerSetting",
      "description": "Persistent planner settings"
    },
    "/posts/{id}": {
      "schema": "Post",
      "description": "Persistent social publications"
    },
    "/post_likes/{likeId}": {
      "schema": "PostLike",
      "description": "Persistent publication likes"
    },
    "/post_comments/{commentId}": {
      "schema": "PostComment",
      "description": "Persistent publication comments"
    },
    "/stories/{id}": {
      "schema": "Story",
      "description": "Persistent 24-hour stories"
    }
  }
}
